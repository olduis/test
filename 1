-- Auto Reload Thresholds
local specificThresholds = {
    ['[Flintlock]'] = 0,
    ['[Rifle]'] = 1,
}
local LastTicks = {} -- 🔑 Stores last tick per target for Δt

function CDesync()
    local target = getgenv().MiscConfiguration.TargetAim.TargetPlayer
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild('HumanoidRootPart')

    if root and target and target.Character and target.Character:FindFirstChild('HumanoidRootPart') then
        local targetChar = target.Character
        local targetRoot = targetChar.HumanoidRootPart

        -- Anti Void Resolver
        if getgenv().AntiAimSettings.ResolveVoid then
            local distance = (root.Position - targetRoot.Position).Magnitude
            if distance > 50000 then
                return
            end
        end

        local origin = targetRoot
        local upperTorso = targetChar:FindFirstChild('UpperTorso') or targetChar:FindFirstChild('Torso')
        local velocityPrediction = Vector3.zero

        -- Prediction Logic
        if upperTorso then
            local lastPos = LastPositions[target.UserId]
            local lastTick = LastTicks[target.UserId]
            local currentPos = upperTorso.Position
            local currentTime = tick()

            local resolvedVelocity = upperTorso.Velocity -- Default

            -- ⭐ VELOCITY RESOLVER (Δd / Δt) ⭐
            if getgenv().AntiAimSettings.VelocityResolver and lastPos and lastTick then
                local deltaTime = currentTime - lastTick
                if deltaTime > 0 then
                    resolvedVelocity = (currentPos - lastPos) / deltaTime
                end
            end

            -- Apply Prediction to the Resolved Velocity
            local predMultiplier = (getgenv().AntiAimSettings.AutoPrediction and PredictionValue) 
                                    or getgenv().AntiAim.C_Desync.PredictionMultiplier 
                                    or 0.5

            velocityPrediction = resolvedVelocity * predMultiplier

            -- Update Tracking
            LastPositions[target.UserId] = currentPos
            LastTicks[target.UserId] = currentTime
        end

        local bodyEffects = targetChar:FindFirstChild('BodyEffects')
        local isKO = bodyEffects and bodyEffects:FindFirstChild('K.O') and bodyEffects['K.O'].Value
        local isDead = bodyEffects and bodyEffects:FindFirstChild('SDeath') and bodyEffects['SDeath'].Value

        -- Save old position
        getgenv().AntiAim.C_Desync.OldPosition = root.CFrame

        local predicted
        local targetUserId = target.UserId
        local currentTime = tick()

        -----------------------------------------------------
        -- ⭐ AUTO-RELOAD WHEN TARGET IS DEAD ⭐
        -----------------------------------------------------
        if isDead then
            if char then
                for _, tool in ipairs(char:GetChildren()) do
                    if tool:IsA("Tool") and tool:FindFirstChild("Ammo") then
                        local ammo = tool.Ammo
                        local threshold = specificThresholds[tool.Name] or 1

                        if ammo.Value <= threshold then
                            ReplicatedStorage.MainEvent:FireServer("Reload", tool)
                        end
                    end
                end
            end
        end

        -- Stomp Logic
        if getgenv().AntiAim.C_Desync.Stomp.Enabled and isKO and not isDead then
            if not KOStartTimes[targetUserId] then
                KOStartTimes[targetUserId] = currentTime
                getgenv().AntiAim.C_Desync.CurrentDist = 400
            end

            if currentTime - KOStartTimes[targetUserId] >= 0.2 then
                if upperTorso then
                    predicted = CFrame.new(upperTorso.Position + Vector3.new(0, 3, 0))
                    ReplicatedStorage.MainEvent:FireServer('Stomp')
                end
            end
        else
            KOStartTimes[targetUserId] = nil
            local forceField = targetChar:FindFirstChildOfClass('ForceField')

            if forceField then
                local randomPos = Vector3.new(
                    root.Position.X + math.random(-10000, 10000),
                    root.Position.Y + math.random(20000, 60000),
                    root.Position.Z + math.random(10000, 40000)
                )
                predicted = CFrame.new(randomPos)
            else
                -- Main CDesync Types
                if getgenv().AntiAim.C_Desync.Type == 'Velocity Counter' then
                    local maxDist = 400
                    local minDist = 50
                    local shrinkRate = 0.2
                    getgenv().AntiAim.C_Desync.CurrentDist = math.max((getgenv().AntiAim.C_Desync.CurrentDist or maxDist) - shrinkRate, minDist)
                    local dist = getgenv().AntiAim.C_Desync.CurrentDist
                    getgenv().AntiAim.C_Desync.LinearPhase = (getgenv().AntiAim.C_Desync.LinearPhase or 0) + 0.15
                    local offset = math.sin(getgenv().AntiAim.C_Desync.LinearPhase) * dist
                    predicted = CFrame.new(origin.Position + (root.CFrame.LookVector * offset))
                elseif getgenv().AntiAim.C_Desync.Type == 'Random' then
                    local offset = Vector3.new(math.random(-20, 20), math.random(-10, 10), math.random(-20, 20))
                    local randomRotation = CFrame.Angles(math.rad(math.random(0, 360)), math.rad(math.random(0, 360)), math.rad(math.random(0, 360)))
                    predicted = CFrame.new(origin.Position + offset + velocityPrediction) * randomRotation
                end
            end
        end

        -- Apply Position
        if predicted then
            if getgenv().AntiAimSettings.LookAtTarget then
                local targetHead = target.Character:FindFirstChild('Head') or target.Character:FindFirstChild('HumanoidRootPart')
                root.CFrame = targetHead and CFrame.lookAt(predicted.Position, targetHead.Position) or predicted
            else
                root.CFrame = predicted
            end

            fireShootGun(target)

            if getgenv().AntiAimSettings.VisualStrafe then
                if not VisualMarker then
                    VisualMarker = Instance.new('Model', workspace)
                    VisualMarker.Name = 'StrafeVisual'
                    local function makeLimb(name, size, offset)
                        local part = Instance.new('Part', VisualMarker)
                        part.Name, part.Anchored, part.CanCollide, part.Size = name, true, false, size
                        part.Transparency, part.Material, part.BrickColor = 0.3, Enum.Material.Neon, BrickColor.new('Bright white')
                        part:SetAttribute('Offset', offset)
                    end
                    makeLimb('Torso', Vector3.new(2, 2, 1), Vector3.new(0, 0, 0))
                    makeLimb('Head', Vector3.new(2, 1, 1), Vector3.new(0, 1.5, 0))
                    makeLimb('LeftLeg', Vector3.new(1, 2, 1), Vector3.new(-0.5, -2, 0))
                    makeLimb('RightLeg', Vector3.new(1, 2, 1), Vector3.new(0.5, -2, 0))
                    makeLimb('LeftArm', Vector3.new(1, 2, 1), Vector3.new(-1.5, 0, 0))
                    makeLimb('RightArm', Vector3.new(1, 2, 1), Vector3.new(1.5, 0, 0))
                end
                for _, part in ipairs(VisualMarker:GetChildren()) do
                    local off = part:GetAttribute('Offset')
                    if off then part.CFrame = predicted * CFrame.new(off) end
                end
            end

            RunService.RenderStepped:Wait()
            root.CFrame = getgenv().AntiAim.C_Desync.OldPosition
        end
    end
end
