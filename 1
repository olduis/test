local RunServiceLoops = {
    HeartbeatT = {},
}
function RunServiceLoops:Heartbeat(Action, Name, Function)
    if Action == 'Bind' then
        if not self.HeartbeatT[Name] then
            self.HeartbeatT[Name] = RunService.Heartbeat:Connect(Function)
        end
    elseif Action == 'Unbind' then
        if self.HeartbeatT[Name] then
            self.HeartbeatT[Name]:Disconnect()
            self.HeartbeatT[Name] = nil
        end
    end
end
--// Closest Player
function GetClosestPlayerToCursor()
    local closest, shortest = nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in ipairs(Players:GetPlayers()) do
        if
            player ~= LocalPlayer
            and player.Character
            and player.Character:FindFirstChild('HumanoidRootPart')
        then
            local shouldSkip = false

            if getgenv().AntiAimSettings.IgnoreKO then
                local bodyEffects =
                    player.Character:FindFirstChild('BodyEffects')
                local isInKO = bodyEffects
                    and bodyEffects:FindFirstChild('K.O')
                    and bodyEffects['K.O'].Value
                if isInKO then
                    shouldSkip = true
                end
            end

            if not shouldSkip then
                local screenPos, onScreen = Camera:WorldToViewportPoint(
                    player.Character.HumanoidRootPart.Position
                )
                if onScreen then
                    local dist = (
                        Vector2.new(screenPos.X, screenPos.Y)
                        - Vector2.new(mousePos.X, mousePos.Y)
                    ).Magnitude
                    if dist < shortest then
                        closest = player
                        shortest = dist
                    end
                end
            end
        end
    end

    return closest
end
-- Per-tool cooldowns so multiple guns fire properly
local gunCooldowns = {}

function fireShootGun(targetPlayer)
    if not targetPlayer or targetPlayer == LocalPlayer then return end

    local char = LocalPlayer.Character
    if not char then return end

    local targetChar = targetPlayer.Character
    if not targetChar then return end

    -- KO / spawn protection check
    local bodyEffects = targetChar:FindFirstChild("BodyEffects")
    if bodyEffects then
        local ko = bodyEffects:FindFirstChild("K.O")
        if ko and ko.Value then return end
    end

    if targetChar:FindFirstChildOfClass("ForceField") then return end

    local head = targetChar:FindFirstChild("Head")
    if not head then return end

    -------------------------------------------------------
    -- ⭐ ADVANCED PREDICTION ⭐
    -------------------------------------------------------
    local predictedPos = head.Position + head.Velocity * 0.20

    -------------------------------------------------------
    -- ⭐ FIND ALL SHOOTABLE GUNS EQUIPPED ⭐
    -------------------------------------------------------
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool:FindFirstChild("Handle") then

            -- skip tools without ammo (melee)
            local ammo = tool:FindFirstChild("Ammo")
            if ammo and ammo.Value > 0 then

                local gunName = tool.Name
                local now = tick()

                -------------------------------------------------------
                -- ⭐ INDIVIDUAL GUN RATE LIMITER ⭐
                -------------------------------------------------------
                if not gunCooldowns[gunName] then
                    gunCooldowns[gunName] = 0
                end

                -- REPLACEMENT FOR CONTINUE
                if now - gunCooldowns[gunName] >= 0.00000000000001 then
                    
                    gunCooldowns[gunName] = now

                    -------------------------------------------------------
                    -- ⭐ SHOOTING STARTS HERE ⭐
                    -------------------------------------------------------
                    local handle = tool.Handle
                    local shootFrom = handle.Position - Vector3.new(0, 10, 0)

                    local targetHum = targetChar:FindFirstChildOfClass("Humanoid")
                    local prevHP = targetHum and targetHum.Health or nil

                    -- Fire gun
                    ReplicatedStorage.MainEvent:FireServer(
                        "ShootGun",
                        handle,
                        shootFrom,
                        predictedPos - Vector3.new(0, 10, 0),
                        head,
                        Vector3.new(0, 0, -1)
                    )

                    -------------------------------------------------------
                    -- ⭐ HIT DETECTION + DAMAGE CALCULATOR ⭐
                    -------------------------------------------------------
                    task.delay(0.05, function()
                        local params = RaycastParams.new()
                        params.FilterDescendantsInstances = {char}
                        params.FilterType = Enum.RaycastFilterType.Blacklist

                        local ray = workspace:Raycast(
                            shootFrom,
                            (predictedPos - shootFrom).Unit * 1000,
                            params
                        )

                        if ray then
                            local model = ray.Instance:FindFirstAncestorOfClass("Model")
                            if model then
                                local hitPlayer = game.Players:GetPlayerFromCharacter(model)
                                if hitPlayer == targetPlayer and prevHP then

                                    -- poll health updates
                                    local newHP = prevHP
                                    for i = 1, 8 do
                                        local h = targetChar:FindFirstChildOfClass("Humanoid")
                                        if h and h.Health ~= prevHP then
                                            newHP = h.Health
                                            break
                                        end
                                        task.wait(0.05)
                                    end

                                    local dmg = math.floor(prevHP - newHP)
                                    if dmg > 0 then
                                        local color = "<font color='rgb(255,85,85)'>"
                                        local reset = "</font>"
                                        Library:Notify(
                                            string.format("Hit! %s (-%s%d HP%s)", hitPlayer.Name, color, dmg, reset),
                                            3
                                        )
                                    end
                                end
                            end
                        end
                    end)
                end -- END of cooldown check
            end
        end
    end
end



