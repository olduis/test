local funcs = {}

function funcs:Beam(startPos, endPos)
    endPos = Vector3.new(endPos.X - 0.1, endPos.Y + 0.2, endPos.Z)
    local colorSequence = ColorSequence.new({
        ColorSequenceKeypoint.new(0, bullet_tracer_color),
        ColorSequenceKeypoint.new(1, bullet_tracer_color),
    })

    local partA = Instance.new('Part', BeamPart)
    partA.Size = Vector3.new(0, 0, 0)
    partA.Massless = true
    partA.Transparency = 1
    partA.CanCollide = false
    partA.Position = startPos
    partA.Anchored = true
    local attachA = Instance.new('Attachment', partA)

    local partB = Instance.new('Part', BeamPart)
    partB.Size = Vector3.new(0, 0, 0)
    partB.Transparency = 0
    partB.CanCollide = false
    partB.Position = endPos
    partB.Anchored = true
    partB.Material = Enum.Material.ForceField
    partB.Color = Settings.ImpactColor
    partB.Massless = true
    local attachB = Instance.new('Attachment', partB)

    local beam = Instance.new('Beam', partA)
    beam.FaceCamera = true
    beam.Color = colorSequence
    beam.Attachment0 = attachA
    beam.Attachment1 = attachB
    beam.LightEmission = 6
    beam.LightInfluence = 1
    beam.Width0 = Settings.StartWidth
    beam.Width1 = Settings.EndWidth
    beam.Texture = getgenv().SelectedTracerTexture
    beam.TextureSpeed = 2
    beam.TextureLength = 1

    task.delay(Settings.Time, function()
        partA:Destroy()
        partB:Destroy()
    end)
end

