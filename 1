char:AddToggle('AutoArmorToggle', {
    Text = 'Rotating Crosshair',
    Default = false,
    Callback = function(state)
        local RunService = game:GetService('RunService')
        local UserInputService = game:GetService('UserInputService')

        local config = {
            SPACING = 5,
            LENGTH = 100,
            THICK = 2,
            COLOR = Color3.fromRGB(25, 255, 255),
            ROT_SPEED = 350,
        }

        -- Use shared upvalue so they persist across toggle calls
        if not getgenv().rotCrosshair then
            getgenv().rotCrosshair = {
                active = false,
                lines = {},
                connection = nil,
            }
        end

        local function disable()
            local rot = getgenv().rotCrosshair
            rot.active = false

            if rot.connection then
                rot.connection:Disconnect()
                rot.connection = nil
            end

            for _, line in ipairs(rot.lines) do
                if line then
                    line.Visible = false
                    line:Destroy() -- Proper cleanup
                end
            end

            rot.lines = {}
        end

        local function crosshair()
            disable()

            local rot = getgenv().rotCrosshair
            rot.active = true
            rot.lines = {
                Drawing.new('Line'),
                Drawing.new('Line'),
                Drawing.new('Line'),
                Drawing.new('Line'),
            }

            for _, line in ipairs(rot.lines) do
                line.Visible = true
                line.Thickness = config.THICK
                line.Color = config.COLOR
            end

            local angle = 0

            rot.connection = RunService.RenderStepped:Connect(function(dt)
                if not rot.active then
                    return
                end

                local mousePos = UserInputService:GetMouseLocation()
                angle = angle + config.ROT_SPEED * dt

                local rad = math.rad(angle)
                local cosA, sinA = math.cos(rad), math.sin(rad)

                local function rotVec(x, y)
                    return Vector2.new(cosA * x - sinA * y, sinA * x + cosA * y)
                end

                local s, l = config.SPACING, config.LENGTH
                local points = {
                    { Vector2.new(0, -l / 2 - s), Vector2.new(0, -s) },
                    { Vector2.new(0, s), Vector2.new(0, l / 2 + s) },
                    { Vector2.new(-l / 2 - s, 0), Vector2.new(-s, 0) },
                    { Vector2.new(s, 0), Vector2.new(l / 2 + s, 0) },
                }

                for i, line in ipairs(rot.lines) do
                    local startPoint = rotVec(points[i][1].X, points[i][1].Y)
                    local endPoint = rotVec(points[i][2].X, points[i][2].Y)
                    line.From = mousePos + startPoint
                    line.To = mousePos + endPoint
                end
            end)
        end

        if state then
            crosshair()
        else
            disable()
        end
    end,
})

