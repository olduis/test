Movement:AddToggle('HitsoundToggle', {
    Text = 'Hit Sound',
    Default = false,
    Callback = function(state)
        hitsoundEnabled = state
        clearConnections()

        if state then
            -- Define functions inside toggle
            local function playHitsound()
                if not hitsoundEnabled then
                    return
                end
                local sound = Instance.new('Sound')
                sound.SoundId = getgenv().hitsounds[selectedHitsound]
                sound.Volume = math.clamp(hitsoundVolume, 0, 2)
                sound.Parent = Workspace
                sound:Play()
                sound.Ended:Once(function()
                    sound:Destroy()
                end)
            end

            local function monitorAmmo(tool)
                local ammo = tool:FindFirstChild('Ammo')
                if ammo and ammo:IsA('IntValue') then
                    local lastAmmo = ammo.Value
                    local conn = ammo:GetPropertyChangedSignal('Value')
                        :Connect(function()
                            if ammo.Value < lastAmmo then
                                playHitsound()
                            end
                            lastAmmo = ammo.Value
                        end)
                    table.insert(hitsoundConnections, conn)
                end
            end

            local function onCharacterAdded(char)
                -- Monitor new tools
                local conn1 = char.ChildAdded:Connect(function(child)
                    if child:IsA('Tool') then
                        monitorAmmo(child)
                    end
                end)
                table.insert(hitsoundConnections, conn1)

                -- Monitor existing tools
                for _, tool in ipairs(char:GetChildren()) do
                    if tool:IsA('Tool') then
                        monitorAmmo(tool)
                    end
                end
            end

            -- Hook character
            local char = Player.Character or Player.CharacterAdded:Wait()
            onCharacterAdded(char)
            local conn2 = Player.CharacterAdded:Connect(onCharacterAdded)
            table.insert(hitsoundConnections, conn2)
        end
    end,
