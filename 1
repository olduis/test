_G.isAfterimageEnabled = false
Visualization:AddToggle('effect', {
    Text = 'Hit Effects',
    Default = false,
    Callback = function(state)
        _G.isAfterimageEnabled = state

        if state then
            -- Function inside toggle
            local function createAfterimage(player)
                if not player.Character then
                    return
                end

                local afterimageFolder = Instance.new('Model')
                afterimageFolder.Name = player.Name .. '_Afterimage'
                afterimageFolder.Parent = workspace

                player.Character.Archivable = true
                local afterimageModel = player.Character:Clone()

                for _, Obj in next, afterimageModel:GetDescendants() do
                    if
                        Obj.Name == 'HumanoidRootPart'
                        or Obj:IsA('Humanoid')
                        or Obj:IsA('LocalScript')
                        or Obj:IsA('Script')
                        or Obj:IsA('Decal')
                    then
                        Obj:Destroy()
                    elseif
                        Obj:IsA('BasePart')
                        or Obj:IsA('MeshPart')
                        or Obj:IsA('Part')
                    then
                        Obj.CanCollide = false
                        Obj.Anchored = true
                        Obj.Material = Enum.Material.ForceField
                        Obj.Color = Color3.fromRGB(204, 204, 255)
                        Obj.Transparency = 0.5
                        Obj.Size = Obj.Size + Vector3.new(0.03, 0.03, 0.03)
                    end
                    pcall(function()
                        Obj.CanCollide = false
                    end)
                end

                afterimageModel.Parent = afterimageFolder
                if afterimageModel.PrimaryPart then
                    afterimageModel:SetPrimaryPartCFrame(
                        player.Character.HumanoidRootPart.CFrame
                    )
                end

                local fadeTime = 2.5
                local tweenInfo = TweenInfo.new(
                    fadeTime,
                    Enum.EasingStyle.Linear,
                    Enum.EasingDirection.Out
                )

                for _, part in ipairs(afterimageModel:GetDescendants()) do
                    if part:IsA('BasePart') then
                        local fadeTween = TweenService:Create(
                            part,
                            tweenInfo,
                            { Transparency = 1 }
                        )
                        fadeTween:Play()
                    end
                end

                task.delay(fadeTime, function()
                    afterimageFolder:Destroy()
                end)
            end

            -- Damage + afterimage check
            local function Damage()
                local player = Players.LocalPlayer
                local gun = player.Character
                    and player.Character:FindFirstChildWhichIsA('Tool')

                if gun and gun:FindFirstChild('Ammo') then
                    for _, target in ipairs(Players:GetPlayers()) do
                        if
                            target ~= player
                            and target.Character
                            and target.Character:FindFirstChildOfClass(
                                'Humanoid'
                            )
                        then
                            local humanoid =
                                target.Character:FindFirstChildOfClass(
                                    'Humanoid'
                                )
                            local currentHealth = humanoid.Health
                            local prevHealth = _G.previousHealth[target.UserId]
                                or currentHealth

                            if currentHealth < prevHealth then
                                local damageDealt =
                                    math.floor(prevHealth - currentHealth)
                                _G.createDamageDisplay(target, damageDealt)
                                createAfterimage(target)
                            end

                            _G.previousHealth[target.UserId] = currentHealth
                        end
                    end
                end
            end

            -- Connect loop inside toggle
            RunService.RenderStepped:Connect(function()
                if _G.isAfterimageEnabled then
                    Damage()
                end
            end)
        end
    end,
})

