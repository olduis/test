function RemoveESP()
    local data = getgenv().ESP_Toggle
    if data.Highlight then
        data.Highlight:Destroy()
        data.Highlight = nil
    end
    if data.Beam then
        if data.Beam.Attachment0 then
            data.Beam.Attachment0:Destroy()
        end
        if data.Beam.Attachment1 then
            data.Beam.Attachment1:Destroy()
        end
        data.Beam:Destroy()
        data.Beam = nil
    end
    if data.CharConnection then
        data.CharConnection:Disconnect()
        data.CharConnection = nil
    end
end

function ApplyESP(targetPlayer)
    RemoveESP()
    local data = getgenv().ESP_Toggle
    local lpChar = LocalPlayer.Character
    local targetChar = targetPlayer.Character
    if not lpChar or not targetChar then
        return
    end
    local lpHRP = lpChar:FindFirstChild('HumanoidRootPart')
    local tpHRP = targetChar:FindFirstChild('HumanoidRootPart')
    if not lpHRP or not tpHRP then
        return
    end

    -- Highlight
    local highlight = Instance.new('Highlight')
    highlight.Name = 'TargetESP'
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Adornee = targetChar
    highlight.Parent = targetChar
    data.Highlight = highlight

    -- Beam
    local a1 = Instance.new('Attachment', lpHRP)
    local a2 = Instance.new('Attachment', tpHRP)

    local beam = Instance.new('Beam')
    beam.Color = ColorSequence.new(Color3.new(1, 0, 0))
    beam.FaceCamera = true
    beam.Width0 = 0.1
    beam.Width1 = 0.1
    beam.Attachment0 = a1
    beam.Attachment1 = a2
    beam.Parent = a1
    data.Beam = beam

    -- Respawn handling
    data.CharConnection = targetPlayer.CharacterAdded:Connect(function(newChar)
        task.wait(0.1)
        ApplyESP(targetPlayer)
    end)
end

