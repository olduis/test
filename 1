local isAutoWeightActive = false
function getCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

function equipItem(itemName)
    local character = getCharacter()
    local itemInBackpack = LocalPlayer.Backpack:FindFirstChild(itemName)
    if itemInBackpack then
        itemInBackpack.Parent = character
        task.wait(0.1)
        local humanoid = character:FindFirstChildOfClass('Humanoid')
        if humanoid then
            humanoid:EquipTool(itemInBackpack)
            character.HumanoidRootPart.CFrame = CFrame.new(-117, -57, 147)
        end
    end
end

function activateItem(itemName)
    local character = getCharacter()
    local item = character:FindFirstChild(itemName)
    if item then
        item:Activate()
    end
end

function buyItem(itemName, itemLocation)
    local character = getCharacter()
    local savePos = character.HumanoidRootPart.CFrame
    local targetPosition = itemLocation.Head.CFrame * CFrame.new(0, 2, 3)
    character.HumanoidRootPart.CFrame = targetPosition
    task.wait(0.25)
    fireclickdetector(itemLocation.ClickDetector)
    task.wait(0.25)
    character.HumanoidRootPart.CFrame = savePos
end

function handleAutoWeight(itemName, itemLocation)
    task.spawn(function()
        while isAutoWeightActive do
            local character = getCharacter()
            local itemEquipped = character:FindFirstChild(itemName)
            if itemEquipped then
                activateItem(itemName)
            else
                local itemInBackpack =
                    LocalPlayer.Backpack:FindFirstChild(itemName)
                if not itemInBackpack then
                    buyItem(itemName, itemLocation)
                    task.wait(0.25)
                end
                equipItem(itemName)
            end
            task.wait(0.1)
        end
    end)
end

