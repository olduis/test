local RocketTP = false
local TargetPlr = nil
local listenerConnected = false

function setupRPGTP()
    if listenerConnected then
        return
    end
    listenerConnected = true

    if workspace:FindFirstChild('Ignored') then
        workspace.Ignored.ChildAdded:Connect(function(object)
            if
                RocketTP
                and TargetPlr
                and TargetPlr.Character
                and (
                    object.Name == 'Model'
                    or object.Name == 'GrenadeLauncherAmmo'
                )
            then
                local isAmmo = object.Name == 'GrenadeLauncherAmmo'
                local part = isAmmo and object:WaitForChild('Main', 2)
                    or object:WaitForChild('Launcher', 2)
                if not part then
                    return
                end

                -- Cleanup
                if not isAmmo then
                    local bv = part:FindFirstChildOfClass('BodyVelocity')
                    local ti =
                        part:FindFirstChildWhichIsA('TouchTransmitter', true)
                    if bv then
                        bv:Destroy()
                    end
                    if ti then
                        ti:Destroy()
                    end
                end

                -- Apply homing behavior
                local connection
                connection = RunService.Heartbeat:Connect(function()
                    if
                        TargetPlr
                        and TargetPlr.Character
                        and TargetPlr.Character:FindFirstChild(
                            'HumanoidRootPart'
                        )
                    then
                        local targetPos =
                            TargetPlr.Character.HumanoidRootPart.Position
                        local partPos = part.Position
                        local direction = (targetPos - partPos).Unit
                        local distance = (targetPos - partPos).Magnitude

                        local speed = math.clamp(distance * 10, 50, 300)
                        part.Velocity = direction * speed
                    end
                end)

                object.Destroying:Connect(function()
                    if connection then
                        connection:Disconnect()
                    end
                end)
            end
        end)
    end
end

