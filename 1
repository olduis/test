getgenv().elapsed = 0
function getHRP()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return character:WaitForChild('HumanoidRootPart')
end
function safeSetFflag(name, value)
    pcall(setfflag, name, value)
end
function safeSetFpscap(val)
    pcall(setfpscap, val)
end
function safeNotify(txt)
    pcall(function()
        if library and type(library.Notify) == 'function' then
            library:Notify(txt)
        elseif library and type(library.notify) == 'function' then
            library:notify(txt)
        else
            Library:Notify('[FakePos] ' .. tostring(txt))
        end
    end)
end
function startFakePos()
    stopFakePos()

    local ok
    ok, getgenv().rootPart = pcall(getHRP)
    if not ok or not getgenv().rootPart then
        return
    end

    getgenv().lastActivationPos = getgenv().rootPart.Position
    getgenv().newPos = getgenv().lastActivationPos

    if getgenv().FakeInVoid then
        getgenv().newPos = Vector3.new(
            getgenv().lastActivationPos.X + math.random(-444444, 444444),
            getgenv().lastActivationPos.Y + math.random(-444444, 444444),
            getgenv().lastActivationPos.Z + math.random(-444444, 444444)
        )
        pcall(function()
            getgenv().rootPart.CFrame = CFrame.new(getgenv().newPos)
        end)
    end

    -- Set flags
    safeSetFflag('DebugDefaultTargetWorldStepsPerFrame', '-2147483648')
    safeSetFflag('DebugSendDistInSteps', '-2147483648')
    safeSetFflag('MaxMissedWorldStepsRemembered', '-2147483648')
    safeSetFflag('PlayerHumanoidPropertyUpdateRestrict', '0')
    safeSetFflag('WorldStepMax', '-2147483648')
    safeSetFflag('S2PhysicsSenderRate', '1')

    safeNotify('FakePos On, pls reset')

    getgenv().elapsed = 0
    while getgenv().elapsed < getgenv().total do
        if getgenv().FakePosCancel then
            break
        end
        task.wait(getgenv().step)
        getgenv().elapsed = getgenv().elapsed + getgenv().step
    end

    if not getgenv().FakePosCancel then
        pcall(function()
            getgenv().rootPart.CFrame = CFrame.new(getgenv().lastActivationPos)
        end)
    end
end

function stopFakePos()
    getgenv().FakePosCancel = true

    pcall(function()
        if getgenv().rootPart and getgenv().lastActivationPos then
            getgenv().rootPart.CFrame = CFrame.new(getgenv().lastActivationPos)
        end
    end)

    -- Restore flags
    safeSetFflag('DebugDefaultTargetWorldStepsPerFrame', '0')
    safeSetFflag('DebugSendDistInSteps', '5')
    safeSetFflag('MaxMissedWorldStepsRemembered', '16')
    safeSetFflag('PlayerHumanoidPropertyUpdateRestrict', '1')
    safeSetFflag('WorldStepMax', '30')
    safeSetFflag('S2PhysicsSenderRate', '200')
    safeSetFpscap(240)

    safeNotify('FakePos Off')
    getgenv().fakeTask = nil
    getgenv().FakePosCancel = false
end

function spawnStartFakePos()
    if getgenv().fakeTask then
        return
    end
    getgenv().FakePosCancel = false
    getgenv().fakeTask = task.spawn(function()
        pcall(startFakePos)
        getgenv().fakeTask = nil
    end)
end
