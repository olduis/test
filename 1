                        end
                    end
                )
            elseif not enabled and getgenv().reloadConnection then
                getgenv().reloadConnection:Disconnect()
                getgenv().reloadConnection = nil
            end
        end

        local function shootAtTargetHead(player)
            local head = player.Character
                and player.Character:FindFirstChild('Head')
            if head then
                local prediction = head.Position + head.Velocity * 0.2
                local tool = localPlayer.Character:FindFirstChildOfClass('Tool')
                if tool and tool:FindFirstChild('Handle') then
                    ReplicatedStorage.MainEvent:FireServer(
                        'ShootGun',
                        tool.Handle,
                        localPlayer.Character.HumanoidRootPart.Position
                            - Vector3.new(0, 10, 0),
                        prediction - Vector3.new(0, 25, 0),
                        head,
                        (
                            prediction
                            - localPlayer.Character.HumanoidRootPart.Position
                        ).unit
                    )
                end
            end
        end

        local function stompTargetPlayer(player)
            local torso = player.Character
                and player.Character:FindFirstChild('UpperTorso')
            local effects = player.Character
                and player.Character:FindFirstChild('BodyEffects')
            if torso and effects then
                while getgenv().isOrbitingActive and not isPlayerDead(player) do
                    localPlayer.Character.HumanoidRootPart.CFrame =
                        CFrame.new(torso.Position + Vector3.new(0, 3, 0))
                    ReplicatedStorage.MainEvent:FireServer('Stomp')
                    task.wait(0.1)
                end
            end
        end

        local function orbitAroundTarget(player)
            if not player.Character or not player.Character.PrimaryPart then
                return
            end
            task.spawn(function()
                Camera.CameraSubject =
                    player.Character:FindFirstChildOfClass('Humanoid')
                local angle = 0
                local root = localPlayer.Character.PrimaryPart
                local targetPart = player.Character.PrimaryPart

                while
                    getgenv().isOrbitingActive
                    and targetPart
                    and player.Character
                do
                    if isPlayerKnockedOut(player) then
                        break
                    end
                    angle = angle + (getgenv().orbitSpeedValue * 0.01)
                    local offset = Vector3.new(
                        math.cos(angle) * getgenv().orbitDistance,
                        getgenv().orbitAltitude,
                        math.sin(angle) * getgenv().orbitDistance
                    )
                    root.CFrame = CFrame.new(
                        targetPart.Position + offset,
                        targetPart.Position
                    )
                    shootAtTargetHead(player)
                    task.wait()
                end

                if getgenv().isOrbitingActive and not isPlayerDead(player) then
                    stompTargetPlayer(player)
                end

                if getgenv().isOrbitingActive then
                    local newTarget = getRandomValidPlayer()
                    if newTarget then
                        orbitAroundTarget(newTarget)
                    else
                        warn('No valid targets left!')
                        getgenv().isOrbitingActive = false
                        resetToOriginalPosition()
                        unequipLMGWeapon(localPlayer.Character)
                        handleAutoReload(false)
                    end
                end
            end)
        end

        -- Toggle logic
        if state then
            local target = getRandomValidPlayer()
            if target and target.Character then
                getgenv().isOrbitingActive = true
                getgenv().initialPosition =
                    localPlayer.Character.PrimaryPart.CFrame
                enableNoCollision(localPlayer.Character)
                equipLMGWeapon(localPlayer.Character)
                handleAutoReload(true)
                orbitAroundTarget(target)
            else
                warn('No valid targets found!')
            end
        else
            getgenv().isOrbitingActive = false -- stops loops immediately
            resetToOriginalPosition()
            unequipLMGWeapon(localPlayer.Character)
            handleAutoReload(false)
        end
    end,
})
