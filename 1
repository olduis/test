toggles:AddToggle('Velocity Desync', { 
    Text = 'Velocity Desync', 
    Default = false,
    Tooltip = 'Makes your velocity desync', 
    Callback = function(state)

        local RunService = game:GetService("RunService")
        local Players = game:GetService("Players")
        local MaxVelocity = 16384

        local Enabled = state
        local Connection = nil
        local RandomSeedLoop = nil
        local Velocities = {
            Velocity = vector.zero,
            AssemblyLinear = vector.zero,
            Rot = vector.zero
        }

        local LocalPlayer = Players.LocalPlayer
        local LocalCharacter = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local LocalHumanoid = LocalCharacter:FindFirstChildOfClass("Humanoid") or LocalCharacter:WaitForChild("Humanoid", 60)
        local LocalRootPart = LocalHumanoid.RootPart or LocalCharacter:WaitForChild("HumanoidRootPart", 60)

        -- Function to start the desync loop
        local function StartDesync()
            if Connection then return end -- prevent double connection

            -- Random Seed Loop
            RandomSeedLoop = task.spawn(function()
                while Enabled do
                    math.randomseed(tick())
                    task.wait(1)
                end
            end)

            -- Main Heartbeat
            Connection = RunService.Heartbeat:Connect(function()
                if not (LocalCharacter and LocalHumanoid and LocalRootPart) then return end
                if not Enabled then return end

                -- save original
                Velocities.Velocity = LocalRootPart.Velocity
                Velocities.Rot = LocalRootPart.RotVelocity
                Velocities.AssemblyLinear = LocalRootPart.AssemblyLinearVelocity

                -- apply fake
                LocalRootPart.RotVelocity = vector.create(math.random(-MaxVelocity, MaxVelocity), math.random(-MaxVelocity, MaxVelocity), math.random(-MaxVelocity, MaxVelocity))
                LocalRootPart.Velocity = vector.create(math.random(-MaxVelocity, MaxVelocity), math.random(-MaxVelocity, MaxVelocity), math.random(-MaxVelocity, MaxVelocity))
                LocalRootPart.AssemblyLinearVelocity = vector.create(math.random(-MaxVelocity, MaxVelocity), math.random(-MaxVelocity, MaxVelocity), math.random(-MaxVelocity, MaxVelocity))

                RunService.PreRender:Wait()

                -- restore
                if LocalRootPart then
                    LocalRootPart.RotVelocity = Velocities.Rot
                    LocalRootPart.Velocity = Velocities.Velocity
                    LocalRootPart.AssemblyLinearVelocity = Velocities.AssemblyLinear
                end
            end)
        end

        -- Function to stop desync
        local function StopDesync()
            Enabled = false
            if Connection then Connection:Disconnect() Connection = nil end
            if RandomSeedLoop then task.cancel(RandomSeedLoop) RandomSeedLoop = nil end

            if LocalRootPart then
                LocalRootPart.Velocity = Velocities.Velocity
                LocalRootPart.RotVelocity = Velocities.Rot
                LocalRootPart.AssemblyLinearVelocity = Velocities.AssemblyLinear
            end
        end

        -- Handle respawn / character added
        LocalPlayer.CharacterAdded:Connect(function(char)
            LocalCharacter = char
            LocalHumanoid = char:WaitForChild("Humanoid")
            LocalRootPart = LocalHumanoid.RootPart or char:WaitForChild("HumanoidRootPart")

            -- restart desync if toggle is ON
            if Enabled then
                StartDesync()
            end
        end)

        -- Run or stop based on toggle state
        if state then
            Enabled = true
            StartDesync()
        else
            StopDesync()
        end
    end,
})


