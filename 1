-- Shared state (outside toggle)
orbitRadius = 10
orbitSpeed = 1000
orbitHeight = 5
isOrbiting = false
local originalPosition = Player.Character
    and Player.Character.PrimaryPart.CFrame
local lmgWeaponName = '[LMG]'
autoReloadConnection = nil

esp:AddToggle('Kill all', {
    Text = 'Knock everyone [LMG Required]',
    Default = false,
    Callback = function(active)
        -- Helpers must be local inside callback,
        -- BUT shared state stays outside
        local function noclipCharacter(character)
            for _, part in pairs(character:GetDescendants()) do
                if part:IsA('BasePart') then
                    part.CanCollide = false
                end
            end
        end

        local function resetCharacterPosition()
            if Player.Character and Player.Character.PrimaryPart then
                Player.Character.PrimaryPart.CFrame = originalPosition
                Camera.CameraSubject =
                    Player.Character:FindFirstChildOfClass('Humanoid')
            end
        end

        local function checkKO(targetPlayer)
            if targetPlayer and targetPlayer.Character then
                local effects =
                    targetPlayer.Character:FindFirstChild('BodyEffects')
                if
                    effects
                    and effects:FindFirstChild('K.O')
                    and effects['K.O'].Value
                then
                    return true
                end
            end
            return false
        end

        local function selectRandomPlayer()
            local all = Players:GetPlayers()
            local valid = {}

            for _, other in pairs(all) do
                if
                    other ~= Player
                    and other.Character
                    and not checkKO(other)
                    and other.Character:FindFirstChild('Humanoid')
                    and other.Character.Humanoid.Health > 0
                    and not other.Character:FindFirstChild('ForceField')
                then
                    table.insert(valid, other)
                end
            end

            return #valid > 0 and valid[math.random(1, #valid)] or nil
        end

        local function equipLMGInCharacter(character)
            local lmg = Player.Backpack:FindFirstChild(lmgWeaponName)
            if lmg then
                lmg.Parent = character
            else
                warn(lmgWeaponName .. ' not found in backpack!')
            end
        end

        local function unequipLMGFromCharacter(character)
            local lmg = character:FindFirstChild(lmgWeaponName)
            if lmg then
                lmg.Parent = Player.Backpack
            end
        end

        local function manageAutoReload(enabled)
            if enabled and not autoReloadConnection then
                autoReloadConnection = RunService.RenderStepped:Connect(
                    function()
                        local character = Player.Character
                        if character then
                            local lmg = character:FindFirstChild(lmgWeaponName)
                            if
                                lmg
                                and lmg:FindFirstChild('Ammo')
                                and lmg.Ammo.Value <= 0
                            then
                                ReplicatedStorage.MainEvent:FireServer(
                                    'Reload',
                                    lmg
                                )
                                task.wait(1)
                                if lmg then
                                    pcall(function()
                                        lmg:Activate()
                                    end)
                                end
                            end
                        end
                    end
                )
            elseif not enabled and autoReloadConnection then
                autoReloadConnection:Disconnect()
                autoReloadConnection = nil
            end
        end

        local function aimAndShootAtTarget(targetPlayer)
            if targetPlayer and targetPlayer.Character then
                local head = targetPlayer.Character:FindFirstChild('Head')
                if head then
                    local prediction = head.Position + head.Velocity * 0.2
                    local character = Player.Character
                    local tool = character
                        and character:FindFirstChildOfClass('Tool')

                    if tool and tool:FindFirstChild('Handle') then
                        ReplicatedStorage.MainEvent:FireServer(
                            'ShootGun',
                            tool.Handle,
                            character.HumanoidRootPart.Position
                                - Vector3.new(0, 10, 0),
                            prediction - Vector3.new(0, 25, 0),
                            head,
                            (prediction - character.HumanoidRootPart.Position).Unit
                        )
                    end
                end
            end
        end

        local function startOrbitingTarget(targetPlayer)
            if not targetPlayer or not targetPlayer.Character then
                warn('Invalid target!')
                return
            end

            Camera.CameraSubject =
                targetPlayer.Character:FindFirstChildOfClass('Humanoid')
            local angle = 0
            local target = targetPlayer.Character.PrimaryPart
            local root = Player.Character.PrimaryPart

            task.spawn(function()
                while isOrbiting and target and targetPlayer.Character do
                    if checkKO(targetPlayer) then
                        break
                    end
                    angle = angle + (orbitSpeed * 0.01)
                    local offset = Vector3.new(
                        math.cos(angle) * orbitRadius,
                        orbitHeight,
                        math.sin(angle) * orbitRadius
                    )
                    root.CFrame =
                        CFrame.new(target.Position + offset, target.Position)

                    if (target.Position - root.Position).Magnitude <= 100 then
                        aimAndShootAtTarget(targetPlayer)
                    end
                    task.wait()
                end

                if isOrbiting then
                    local newTarget = selectRandomPlayer()
                    if newTarget then
                        startOrbitingTarget(newTarget)
                    else
                        warn('No valid targets left!')
                        isOrbiting = false
                        resetCharacterPosition()
                        unequipLMGFromCharacter(Player.Character)
                        manageAutoReload(false)
                    end
                end
            end)
        end

        -- Toggle logic
        if active then
            local target = selectRandomPlayer()
            if target and target.Character then
                isOrbiting = true
                originalPosition = Player.Character.PrimaryPart.CFrame
                noclipCharacter(Player.Character)
                equipLMGInCharacter(Player.Character)
                manageAutoReload(true)
                startOrbitingTarget(target)
            else
                warn('No valid targets found!')
            end
        else
            isOrbiting = false -- stops the loop
            resetCharacterPosition()
            unequipLMGFromCharacter(Player.Character)
            manageAutoReload(false)
        end
    end,
})

