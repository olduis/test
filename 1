Movement:AddInput('TargetUser', {
    Default = '',
    Numeric = false,
    Finished = true,
    Text = 'Enter Target Username/Display Name:',
    Tooltip = 'Supports multiple targets. Re-enter to untarget.',
    Placeholder = 'Enter username or display name...',
    MaxLength = 50,
    Callback = function(value)
        local input = string.lower(value)

        -- If already exists -> remove target & disconnect loop
        if targetConnections[input] then
            targetConnections[input]:Disconnect()
            targetConnections[input] = nil
            Library:Notify('Removed target: ' .. input, 5)
            return
        end

        -- Try to match a player now
        local matchedPlayer = nil
        for _, p in pairs(Players:GetPlayers()) do
            if
                string.find(string.lower(p.Name), input, 1, true)
                or string.find(string.lower(p.DisplayName), input, 1, true)
            then
                matchedPlayer = p
                Library:Notify(
                    'Added target: ' .. p.DisplayName .. ' (' .. p.Name .. ')',
                    5
                )
                break
            end
        end

        if not matchedPlayer then
            Library:Notify('Target not found.', 5)
            return
        end

        -- Bind RunService loop for this target
        targetConnections[input] = RunService.Heartbeat:Connect(function()
            local target = matchedPlayer
            if
                target
                and target.Character
                and target.Character:FindFirstChild('Head')
            then
                local bodyEffects =
                    target.Character:FindFirstChild('BodyEffects')
                local isInKO = bodyEffects
                    and bodyEffects:FindFirstChild('K.O')
                    and bodyEffects['K.O'].Value
                local isDead = bodyEffects
                    and bodyEffects:FindFirstChild('Dead')
                    and bodyEffects['Dead'].Value

                local targetPosition = target.Character.Head.Position
                if Character and Character:FindFirstChild('Head') then
                    local myPosition = Character.Head.Position
                    local distance = (myPosition - targetPosition).Magnitude

                    if isInKO then
                        if stompWhenKnocked then
                            local upperTorso =
                                target.Character:FindFirstChild('UpperTorso')
                            if upperTorso and not isDead then
                                if typeof(toggleDesync) == 'function' then
                                    toggleDesync(false)
                                end
                                MainEvent:FireServer('Stomp')
                                task.wait(1)
                                Character:PivotTo(
                                    CFrame.new(
                                        upperTorso.Position
                                            + Vector3.new(0, 3, 0)
                                    )
                                )
                                if
                                    isDead
                                    and typeof(toggleDesync) == 'function'
                                then
                                    toggleDesync(true)
                                end
                            end
                        end
                    elseif distance <= 250 then
                        for _, tool in ipairs(Character:GetChildren()) do
                            if
                                tool:IsA('Tool')
                                and tool:FindFirstChild('Handle')
                                and tool:FindFirstChild('Ammo')
                            then
                                MainEvent:FireServer(
                                    'ShootGun',
                                    tool.Handle,
                                    tool.Handle.CFrame.Position,
                                    targetPosition,
                                    target.Character.Head,
                                    Vector3.new(0, 0, -1)
                                )
                            end
                        end
                    end
                end
            end
        end)
    end,
})

